{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grab",
  "version": "0.1.0",
  "identifier": "com.grab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grab",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "publisher": "Grab Project",
    "copyright": "Copyright © 2026 Grab contributors. MIT licensed.",
    "category": "Utility",
    "shortDescription": "Download media from YouTube, Instagram, TikTok and more.",
    "longDescription": "Grab is a calm, fast desktop downloader built on yt-dlp and ffmpeg. Paste a link, pick a quality, and it lands in your downloads folder. Intended for content you own, content licensed for reuse, or content you have permission to download.",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "Grab"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
