{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grab",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0A0A0A"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"]
  }
}
